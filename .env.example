# Portul pe care ascultă serverul Express
PORT=3000

# Calea către fișierul bazei de date SQLite (relativ la rădăcina proiectului)
DB_PATH=./database/restaurant.sqlite

# Credențialele pentru Admin Dashboard (autentificare HTTP Basic).
# Sunt obligatorii: dacă lipsesc, rutele /api/admin/* și pagina admin.html
# răspund cu 503 și rămân inaccesibile. Nu există o parolă implicită în cod,
# tocmai pentru ca o valoare din sursă să nu devină publică odată cu ea.
# Alege o parolă proprie, lungă, și nu refolosi exemplul de mai jos.
ADMIN_USER=admin
ADMIN_PASSWORD=inlocuieste-cu-o-parola-lunga

# Server SMTP pentru e-mailul de confirmare a rezervării.
# Dacă aceste valori lipsesc, aplicația funcționează normal, dar nu trimite e-mailuri.
SMTP_HOST=smtp.exemplu.ro
SMTP_PORT=587
SMTP_USER=rezervari@exemplu.ro
SMTP_PASS=parola-smtp
# Opțional: adresa afișată ca expeditor (implicit SMTP_USER)
SMTP_FROM=rezervari@exemplu.ro
